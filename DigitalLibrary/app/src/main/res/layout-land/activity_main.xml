<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape variant for main screen containing compact stats cards, 44dp search bar, spinners, and full-scroll catalog list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top Action Bar Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <!-- NestedScrollView wrapping the entire home content so all 10 books render and scroll smoothly in landscape -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- STATS CARDS SECTION (3 COMPACT CARDS SIDE BY SIDE FOR LANDSCAPE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 1: Total Books -->
                <LinearLayout
                    android:id="@+id/cardTotalBooks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_icon_circle"
                        android:contentDescription="Total books icon"
                        android:padding="5dp"
                        android:src="@drawable/ic_book_white" />

                    <TextView
                        android:id="@+id/totalBooksTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="10"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Total Books"
                        android:textColor="#666666"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Card 2: Remaining Books (Available Count) -->
                <LinearLayout
                    android:id="@+id/cardRemainingBooks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_icon_circle_green"
                        android:contentDescription="Remaining books icon"
                        android:padding="5dp"
                        android:src="@drawable/ic_book_white" />

                    <TextView
                        android:id="@+id/remainingBooksTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="10"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Remaining"
                        android:textColor="#666666"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Card 3: Interactive Currently Borrowed Tile -->
                <LinearLayout
                    android:id="@+id/cardBorrowedTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="Borrowed books icon"
                            android:padding="5dp"
                            android:src="@drawable/ic_bookmark_white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_badge"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="1dp"
                            android:text="Active"
                            android:textColor="#666666"
                            android:textSize="9sp" />

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/borrowedNumberTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 / 3"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Borrowed (Max 3)"
                        android:textColor="#666666"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- SEARCH & FILTER CONTROLLERS CONTAINER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <!-- COMPACT SEARCH BAR FOR LANDSCAPE (44dp HEIGHT) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Search icon"
                        android:src="@drawable/ic_search_purple" />

                    <EditText
                        android:id="@+id/edit_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/clearSearchButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@null"
                        android:contentDescription="Clear search"
                        android:src="@drawable/ic_clear_grey"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Category and Availability Dropdown Spinners Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinner_category"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp" />

                    <Spinner
                        android:id="@+id/spinner_availability"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- EMPTY STATE TEXTVIEW -->
            <TextView
                android:id="@+id/text_no_books"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/no_books_found"
                android:textColor="#888888"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- RECYCLERVIEW LIST FOR CATALOG BOOKS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_books"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingTop="2dp"
                android:paddingBottom="6dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
