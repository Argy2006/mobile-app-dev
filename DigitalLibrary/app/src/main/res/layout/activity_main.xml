<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen layout containing toolbar and a NestedScrollView viewport allowing all 10 books to render and scroll smoothly -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top Action Bar Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <!-- NestedScrollView wrapping the entire home content so all 10 catalog books measure and scroll properly in all orientations -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- STATS CARDS SECTION (3 CARDS SIDE BY SIDE) -->
            <!-- Displays Total Books, Remaining Available Books, and Interactive Currently Borrowed Tile (Limit 3) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 1: Total Books -->
                <LinearLayout
                    android:id="@+id/cardTotalBooks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Round purple circle with white book icon -->
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle"
                        android:contentDescription="Total books icon"
                        android:padding="6dp"
                        android:src="@drawable/ic_book_white" />

                    <!-- Big bold number showing total book catalog count -->
                    <TextView
                        android:id="@+id/totalBooksTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="10"
                        android:textColor="@color/black"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Small grey label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Total Books"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Card 2: Remaining Books (Available Count) -->
                <LinearLayout
                    android:id="@+id/cardRemainingBooks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Round green circle with white book icon -->
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_green"
                        android:contentDescription="Remaining books icon"
                        android:padding="6dp"
                        android:src="@drawable/ic_book_white" />

                    <!-- Big bold number showing remaining available books count -->
                    <TextView
                        android:id="@+id/remainingBooksTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="10"
                        android:textColor="@color/black"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Small grey label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Remaining"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Card 3: Interactive Currently Borrowed Tile -->
                <!-- Tapping this tile opens the My Borrowed Books screen -->
                <LinearLayout
                    android:id="@+id/cardBorrowedTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Top row relative layout containing bookmark icon and Active badge -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- Round purple circle with white bookmark icon -->
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="Borrowed books icon"
                            android:padding="6dp"
                            android:src="@drawable/ic_bookmark_white" />

                        <!-- Small white rounded Active badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_badge"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="Active"
                            android:textColor="#666666"
                            android:textSize="10sp" />

                    </RelativeLayout>

                    <!-- Big bold number showing currently borrowed count out of max 3 limit -->
                    <TextView
                        android:id="@+id/borrowedNumberTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 / 3"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Small grey label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Borrowed (Max 3)"
                        android:textColor="#666666"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- SEARCH & FILTER CONTROLLERS CONTAINER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <!-- ROUNDED PILL-SHAPED SEARCH BAR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <!-- Purple magnifying glass search icon -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Search icon"
                        android:src="@drawable/ic_search_purple" />

                    <!-- Search input edit text -->
                    <EditText
                        android:id="@+id/edit_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/black" />

                    <!-- Clear search button (visible only when search bar has text) -->
                    <ImageButton
                        android:id="@+id/clearSearchButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@null"
                        android:contentDescription="Clear search"
                        android:src="@drawable/ic_clear_grey"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Category and Availability Dropdown Spinners Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinner_category"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp" />

                    <Spinner
                        android:id="@+id/spinner_availability"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- EMPTY STATE TEXTVIEW -->
            <TextView
                android:id="@+id/text_no_books"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/no_books_found"
                android:textColor="#888888"
                android:textSize="18sp"
                android:visibility="gone" />

            <!-- RECYCLERVIEW LIST FOR CATALOG BOOKS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_books"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
